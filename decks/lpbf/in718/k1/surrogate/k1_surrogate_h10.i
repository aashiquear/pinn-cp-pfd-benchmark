# Part V, network route on case K1: parametric surrogate of the single-track response.
#
# WHAT IT LEARNS: for a track on bare alloy 718 with laser power P, scan speed v and beam
#   diameter D4sigma, (a) the peak temperature reached along the depth below the track axis
#   and (b) the melt-pool depth and width. Training data: 30 PINNACLE finite-element runs
#   of the K1 template at 10 um (design_h10.i; scripts/lpbf_k1_surrogate.py), of which 6 are
#   held out. The seven NIST cases are never training data; the trained surrogate is asked
#   for them (`evaluate`) and compared with the FE runs of those cases and with the
#   measurements.
#
# WHY DATA ONLY: the response is the outcome of a transient with melting; PINNACLE's
#   surrogate refuses a physics source for evolution kernels, and trains on the generator's
#   data (ADR 0030). The parameters carry `path = none`: the samples are read from
#   `data_dir`, nothing is generated by this deck.
#
# THE BLOCKS BELOW [Parameters] are the K1 deck at a very coarse mesh: the surrogate
#   executioner needs a composed problem to bind to, and uses none of its fields.
#
# RUN: after `lpbf_k1_surrogate.py design_h10.i design, decks, run, targets`,
#     cd decks/lpbf/in718/k1/surrogate && pinnacle run k1_surrogate_h10.i
#   (relative paths resolve against the working directory).
#
# UNITS: power W, speed mm/s, diameter um in the parameter columns; temperatures K,
#   lengths um in the targets.

[Global]
  backend    = torch
  use_gpu    = false
  precision  = float64
  seed       = 0
  output_dir = ../../../../../results/lpbf/in718/k1/surrogate_h10/model
[]

[Problem]
  type          = composed
  dimension     = 3
  finite_strain = false
[]

[Mesh]
  type      = box_mesh
  dim       = 3
  domain    = '0.0 0.0 0.0 700.0e-6 300.0e-6 350.0e-6'
  divisions = '14 6 7'      # carrier problem only: the surrogate is trained on stored runs
[]

[Variables]
  [./temperature]
    family     = fem
    components = 1
    order      = 2
  []
[]

[Materials]
  [./in718]
    type     = phase_change_thermal
    solidus  = 1528.15            # 1255 C (hosaeus 2001 liquid)
    liquidus = 1610.15            # 1337 C (hosaeus 2001 liquid)
    # rho0 L = 8190 kg/m3 x 196.85 kJ/kg (agazhanov 2019 thermophysical, Table 1)
    latent_heat = 1.6122e9
    # rho0 c_p(T), rho0 = 8190 kg/m3; c_p: agazhanov Table 2 to 1400 K, hosaeus Table 2 at
    # the solidus (659) and in the liquid (775 J/kg/K)
    heat_capacity_table = '298.0 3.4808e6 400.0 3.6609e6 500.0 3.8329e6 600.0 4.0049e6 700.0 4.1769e6 800.0 4.3489e6 1100.0 5.2007e6 1200.0 5.2007e6 1300.0 5.2007e6 1400.0 5.1925e6 1528.15 5.3972e6 1610.15 6.3473e6'
    # agazhanov Table 2 (held at its last value up to the solidus)
    conductivity_solid_table = '298.0 9.94 400.0 11.59 500.0 13.24 600.0 14.91 700.0 16.61 800.0 18.34 1100.0 22.72 1200.0 23.61 1300.0 24.47 1400.0 25.32'
    # Wiedemann-Franz from the liquid resistivity of hosaeus Table 2 (derived)
    conductivity_liquid_table = '1610.15 26.800 1673.15 27.700 1773.15 29.100 1873.15 30.450 1973.15 31.800 2073.15 33.130'
    reference_temperature = 298.0
  []
[]

[Utilities]
  [./scan]
    kind         = scan_path
    power        = 285.0
    speed        = 0.9600
    radius       = 3.3500e-05        # 1/e^2 radius = D4sigma / 2
    track_length = 500.0e-6
    tracks       = 1
    center       = '350.0e-6 150.0e-6 350.0e-6'
  []
  [./state]
    kind        = process_state
    variable    = temperature
    material    = in718
    scan_path   = scan
  []
[]

[Kernels]
  [./storage]
    type          = enthalpy_time_derivative
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./conduction]
    type          = phase_change_conduction
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./laser]
    type              = beam_heat_source
    variable          = temperature
    scan_path         = scan
    absorptivity      = 0.77240
    penetration_depth = 4.50100e-05
  []
  [./surface]
    type                     = surface_heat_loss
    variable                 = temperature
    scan_path                = scan
    band_thickness           = 1.000e-05
    ambient_temperature      = 296.65
    convection_coefficient   = 10.0
    emissivity               = 0.4
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
    recondensation_fraction  = 0.18
  []
[]

[ICs]
  [./plate]
    variable = temperature
    kind     = constant
    value    = 296.65
  []
[]

[Parameters]
  [./power]
    path  = none
    range = '230.0 340.0'
  []
  [./speed]
    path  = none
    range = '750.0 1250.0'
  []
  [./d4sigma]
    path  = none
    range = '45.0 86.0'
  []
[]

[Executioner]
  type            = parametric_surrogate
  sources         = data
  target          = reduced
  variable        = temperature
  columns         = 'peak_temperature'
  abscissa        = depth_um
  samples_file    = ../../../../../results/lpbf/in718/k1/surrogate_h10/targets/samples.csv
  data_dir        = ../../../../../results/lpbf/in718/k1/surrogate_h10/targets
  missing_samples = skip
  holdout         = 0.2              # 6 of the 30 tracks
  seed            = 0
  scalars         = 'depth_um width_um'
  architecture    = trunk_heads
  trunk_layers    = 2
  head_layers     = 1
  neurons         = 32
  ensemble        = 5
  ensemble_flag   = 0.1
  epochs_adam     = 3000
  epochs_lbfgs    = 50
  lr              = 2.0e-3
  certify         = false
  evaluate        = ../../../../../results/lpbf/in718/k1/surrogate_h10/targets/nist_cases.csv
[]

[Output]
  formats         = 'csv json'
  save_checkpoint = false
[]
