# GENERATED by scripts/lpbf_k1.py from k1_keyhole_study_h10_b.i: case case1.1 (NIST line 1.1), mesh 10 um.
# Part V, case K1 with a KEYHOLE-NUMBER heat source and a defect report (template).
#
# The file is a template: scripts/lpbf_k1.py fills the {NAME} fields from the study deck
# and writes one standalone PINNACLE deck per case.
#
# PROBLEM: as k1_template.i (one laser track on a plate of alloy 718, conduction with
#   latent heat and surface losses, no flow; NIST AMB2022-03 cross sections as target).
#
# DIFFERENCE: the depth over which the beam deposits its heat is not a fitted constant.
#   `penetration_model = keyhole_number` sets the decay length of the source to
#   keyhole_depth_share x e, with the depth of the vapor depression
#       e = r_0 x 0.4 x (Ke - 1.4),   Ke = eta P / ((T_l - T_0) pi rho c_p sqrt(alpha V r_0^3))
#   (gan 2021 keyhole; PINNACLE ADR 0055), never below `penetration_depth` (one
#   element here: the conduction mode). The keyhole number is evaluated with
#   `keyhole_absorptivity`, the absorptivity the study deck states.
#
# ADDED BLOCK: [Utilities] defects (`defect_indicators`): keyhole number and regime,
#   normalized enthalpy, pool length, width and depth with the keyhole and balling
#   ratios, written to defects.json.
#
# UNITS: SI (m, s, K, W, J). Temperatures are absolute.
#
# PROVENANCE of the material values: docs/16_lpbf_notebook.md, section 2.

[Global]
  backend    = torch
  use_gpu    = true
  precision  = float64
  seed       = 0
  output_dir = ../../../../../../results/lpbf/in718/k1/keyhole_h10_b/case1.1
[]

[Problem]
  type          = composed
  dimension     = 3
  finite_strain = false
[]

[Mesh]
  type      = box_mesh
  dim       = 3
  domain    = '0.0 0.0 0.0 700.0e-6 300.0e-6 350.0e-6'
  divisions = '70 30 35'
[]

[Variables]
  [./temperature]
    family     = fem
    components = 1
    order      = 2
  []
[]

[Materials]
  [./in718]
    type     = phase_change_thermal
    solidus  = 1528.15            # 1255 C (hosaeus 2001 liquid)
    liquidus = 1610.15            # 1337 C (hosaeus 2001 liquid)
    # rho0 L = 8190 kg/m3 x 196.85 kJ/kg (agazhanov 2019 thermophysical, Table 1)
    latent_heat = 1.6122e9
    # rho0 c_p(T), rho0 = 8190 kg/m3; c_p: agazhanov Table 2 to 1400 K, hosaeus Table 2 at
    # the solidus (659) and in the liquid (775 J/kg/K)
    heat_capacity_table = '298.0 3.4808e6 400.0 3.6609e6 500.0 3.8329e6 600.0 4.0049e6 700.0 4.1769e6 800.0 4.3489e6 1100.0 5.2007e6 1200.0 5.2007e6 1300.0 5.2007e6 1400.0 5.1925e6 1528.15 5.3972e6 1610.15 6.3473e6'
    # agazhanov Table 2 (held at its last value up to the solidus)
    conductivity_solid_table = '298.0 9.94 400.0 11.59 500.0 13.24 600.0 14.91 700.0 16.61 800.0 18.34 1100.0 22.72 1200.0 23.61 1300.0 24.47 1400.0 25.32'
    # Wiedemann-Franz from the liquid resistivity of hosaeus Table 2 (derived)
    conductivity_liquid_table = '1610.15 26.800 1673.15 27.700 1773.15 29.100 1873.15 30.450 1973.15 31.800 2073.15 33.130'
    reference_temperature = 298.0
  []
[]

[Utilities]
  [./scan]
    kind         = scan_path
    power        = 285.0
    speed        = 0.9600
    radius       = 2.4500e-05        # 1/e^2 radius = D4sigma / 2
    track_length = 500.0e-6
    tracks       = 1
    center       = '350.0e-6 150.0e-6 350.0e-6'
  []
  [./state]
    kind        = process_state
    variable    = temperature
    material    = in718
    scan_path   = scan
    record_file = ../../../../../../results/lpbf/in718/k1/keyhole_h10_b/case1.1/process_state.npz
  []
  [./defects]
    kind                  = defect_indicators
    scan_path             = scan
    process_state         = state
    material              = in718
    absorptivity          = 0.50000
    substrate_temperature = 296.65
    boiling_temperature   = 3186.0
    report_file           = ../../../../../../results/lpbf/in718/k1/keyhole_h10_b/case1.1/defects.json
  []
[]

[Kernels]
  [./storage]
    type          = enthalpy_time_derivative
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./conduction]
    type          = phase_change_conduction
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./laser]
    type              = beam_heat_source
    variable          = temperature
    scan_path         = scan
    material          = in718
    absorptivity      = 0.77240
    penetration_depth = 1.00000e-05        # smallest decay length (conduction mode)
    penetration_model = keyhole_number
    keyhole_absorptivity  = 0.50000
    keyhole_depth_share   = 0.5
    substrate_temperature = 296.65
  []
  [./surface]
    type                     = surface_heat_loss
    variable                 = temperature
    scan_path                = scan
    band_thickness           = 1.000e-05
    ambient_temperature      = 296.65
    convection_coefficient   = 10.0
    emissivity               = 0.4
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
    recondensation_fraction  = 0.18
  []
[]

[ICs]
  [./plate]
    variable = temperature
    kind     = constant
    value    = 296.65
  []
[]

[Executioner]
  type         = pf_fem_explicit
  dt           = 2.5545e-06            # 0.8 of h^2 / (6 a), a = 5.22e-6 m2/s (liquid at 1800 C)
  n_steps      = 100000
  end_time     = 1.2000e-03
  energy_every = 0
[]

[Output]
  formats         = 'json'
  save_checkpoint = false
[]
