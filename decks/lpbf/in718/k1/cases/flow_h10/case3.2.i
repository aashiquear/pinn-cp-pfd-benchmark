# GENERATED by scripts/lpbf_k1.py from k1_flow_study_h10.i: case case3.2 (NIST line 3.2), mesh 10 um.
# Part V, case K1 WITH MELT-POOL FLOW: bare-plate single track on alloy 718 (template).
#
# PROBLEM: as k1_template.i (one laser track of 500 um on a plate, NIST AMB2022-03), with
#   the flow of the liquid: thermocapillary (Marangoni) shear and recoil pressure on the
#   flat surface, buoyancy, drag of the mushy zone, and the heat carried by the flow.
#
# THE BLOCK STORY: the temperature blocks are those of k1_template.i. Added: the unknowns
#   velocity (3 components) and pressure; `flow_momentum`, `thermocapillary_shear` and
#   `flow_continuity` (weakly compressible flow, PINNACLE ADR 0052); `flow_heat_advection`
#   on the temperature. Solid material is at rest through the drag.
#
# LOADING STORY: the beam only. The flow starts from rest and is driven by the
#   temperature field the beam produces.
#
# TIME: explicit. The heat equation takes steps `dt`; velocity and pressure are advanced
#   after it, `staged_substeps` times per step, velocity first (stable order). The step
#   of the flow is bound by the artificial sound speed, c dt_flow < 0.6 h / sqrt(3).
#
# FLOW PROPERTIES (docs/16_lpbf_notebook.md, section 12): liquid density 7,578 kg/m3 and
#   viscosity 5.3 mPa s (the table of the NIST AM Bench CFD study, amin 2024 heatsource,
#   read through a literature tool, not from the PDF); d gamma / dT, expansion coefficient
#   and drag constant are ASSUMED (values in common use; study deck).
#
# FIELDS IN BRACES are filled by scripts/lpbf_k1.py from the study deck.
#
# UNITS: SI (m, s, K, W, J, Pa).

[Global]
  backend    = torch
  use_gpu    = true
  precision  = float64
  seed       = 0
  output_dir = ../../../../../../results/lpbf/in718/k1/flow_h10/case3.2
[]

[Problem]
  type          = composed
  dimension     = 3
  finite_strain = false
[]

[Mesh]
  type      = box_mesh
  dim       = 3
  domain    = '0.0 0.0 0.0 700.0e-6 300.0e-6 350.0e-6'
  divisions = '70 30 35'
[]

[Variables]
  [./temperature]
    family     = fem
    components = 1
    order      = 2
  []
  [./velocity]
    family     = fem
    components = 3
    order      = 2
  []
  [./pressure]
    family     = fem
    components = 1
    order      = 2
  []
[]

[Materials]
  [./in718]
    type     = phase_change_thermal
    solidus  = 1528.15            # 1255 C (hosaeus 2001 liquid)
    liquidus = 1610.15            # 1337 C (hosaeus 2001 liquid)
    # rho0 L = 8190 kg/m3 x 196.85 kJ/kg (agazhanov 2019 thermophysical, Table 1)
    latent_heat = 1.6122e9
    # rho0 c_p(T), rho0 = 8190 kg/m3; c_p: agazhanov Table 2 to 1400 K, hosaeus Table 2 at
    # the solidus (659) and in the liquid (775 J/kg/K)
    heat_capacity_table = '298.0 3.4808e6 400.0 3.6609e6 500.0 3.8329e6 600.0 4.0049e6 700.0 4.1769e6 800.0 4.3489e6 1100.0 5.2007e6 1200.0 5.2007e6 1300.0 5.2007e6 1400.0 5.1925e6 1528.15 5.3972e6 1610.15 6.3473e6'
    # agazhanov Table 2 (held at its last value up to the solidus)
    conductivity_solid_table = '298.0 9.94 400.0 11.59 500.0 13.24 600.0 14.91 700.0 16.61 800.0 18.34 1100.0 22.72 1200.0 23.61 1300.0 24.47 1400.0 25.32'
    # Wiedemann-Franz from the liquid resistivity of hosaeus Table 2 (derived)
    conductivity_liquid_table = '1610.15 26.800 1673.15 27.700 1773.15 29.100 1873.15 30.450 1973.15 31.800 2073.15 33.130'
    reference_temperature = 298.0
  []
[]

[Utilities]
  [./scan]
    kind         = scan_path
    power        = 245.0
    speed        = 0.9600
    radius       = 3.3500e-05        # 1/e^2 radius = D4sigma / 2
    track_length = 500.0e-6
    tracks       = 1
    center       = '350.0e-6 150.0e-6 350.0e-6'
  []
  [./state]
    kind        = process_state
    variable    = temperature
    material    = in718
    scan_path   = scan
    record_file = ../../../../../../results/lpbf/in718/k1/flow_h10/case3.2/process_state.npz
  []
[]

[Kernels]
  [./storage]
    type          = enthalpy_time_derivative
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./conduction]
    type          = phase_change_conduction
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./laser]
    type              = beam_heat_source
    variable          = temperature
    scan_path         = scan
    absorptivity      = 0.77240
    penetration_depth = 4.50100e-05
  []
  [./surface]
    type                     = surface_heat_loss
    variable                 = temperature
    scan_path                = scan
    band_thickness           = 1.000e-05
    ambient_temperature      = 296.65
    convection_coefficient   = 10.0
    emissivity               = 0.4
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
    recondensation_fraction  = 0.18
  []
  [./carried]
    type      = flow_heat_advection
    variable  = temperature
    velocity  = velocity
    material  = in718
    upwind    = 1
    mesh_size = 1.000e-05
    reference_temperature = 1610.15    # enthalpy of the liquid at the liquidus
  []
  [./u_dot]
    type     = time_derivative
    variable = velocity
  []
  [./momentum]
    type                  = flow_momentum
    variable              = velocity
    pressure              = pressure
    temperature           = temperature
    material              = in718
    density               = 7578.0        # kg/m3, liquid
    viscosity             = 5.3e-3        # Pa s
    gravity               = '0.0 0.0 -9.81'
    expansion_coefficient = 5.0e-5        # 1/K, assumed
    reference_temperature = 1610.15
    drag_coefficient      = 1.0e8         # 1/s, assumed
    upwind                = 1
    mesh_size             = 1.000e-05
  []
  [./marangoni]
    type                     = thermocapillary_shear
    variable                 = velocity
    temperature              = temperature
    material                 = in718
    density                  = 7578.0
    surface_tension_gradient = -1.1000e-04
    band_thickness           = 1.000e-05
    scan_path                = scan
    recoil_coefficient       = 0.54
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
  []
  [./p_dot]
    type     = time_derivative
    variable = pressure
  []
  [./mass]
    type                 = flow_continuity
    variable             = pressure
    velocity             = velocity
    density              = 7578.0
    sound_speed          = 25
    pressure_diffusivity = 1.2500e-05
  []
[]

[ICs]
  [./plate]
    variable = temperature
    kind     = constant
    value    = 296.65
  []
  [./rest]
    variable = velocity
    kind     = constant
    value    = 0.0
  []
  [./p0]
    variable = pressure
    kind     = constant
    value    = 0.0
  []
[]

[Executioner]
  type         = pf_fem_explicit
  dt           = 5.2869e-07            # 0.8 of h^2 / (6 (a + a_u U h / 2)), U the speed bound of the study deck
  n_steps      = 100000
  end_time     = 1.2000e-03
  energy_every = 0
  staged_variables = 'velocity pressure'
  staged_substeps  = 4
  snapshots_every  = 57
[]

[Output]
  formats         = 'json'
  save_checkpoint = false
[]
