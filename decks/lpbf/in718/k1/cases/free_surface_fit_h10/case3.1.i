# GENERATED by scripts/lpbf_k1.py from k1_free_surface_study_h10_b.i: case case3.1 (NIST line 3.1), mesh 10 um.
# Part V, case K1 WITH A FREE SURFACE: bare-plate single track on alloy 718 (template).
#
# PROBLEM: as k1_flow_template.i (one laser track of 500 um on a plate, NIST AMB2022-03,
#   with the flow of the liquid), with the surface of the plate FREE TO MOVE. A layer of
#   gas lies above the plate; a phase field `phi` (1 in the metal, 0 in the gas) marks
#   the surface and moves with the liquid (PINNACLE ADR 0058). The vapor recoil can push
#   the surface down, and the beam, the losses and the surface forces go with it.
#
# THE BLOCK STORY: the blocks of k1_flow_template.i, with `phase = phi` on every kernel
#   that knows the surface: the balance terms are weighted by phi (the gas is a light
#   phantom), the beam deposits its flux where a vertical ray meets the surface (no
#   penetration depth: `penetration_depth` is not used), the losses and the surface
#   stress gamma(T) (I - n n) |grad phi| (capillary pressure and thermocapillary shear)
#   and the recoil act on |grad phi|. Added: the unknown `phi` with `phase_advection`.
#
# LOADING STORY: the beam only; the surface starts flat at z = 350 um.
#
# WHAT IS NOT IN THE MODEL: reflections of the beam inside the depression, the angle
#   dependence of the absorptivity, the loss of mass by evaporation, the gas flow.
#
# PARAMETERS: as k1_flow_template.i. New: surface tension 1.8 N/m at the liquidus
#   (ASSUMED, a value in common use for nickel alloys; the gradient as before), width of
#   the surface profile 0.7 element sizes, speed of the profile-keeping term and damping
#   of the gas (numerical; study deck).
#
# FIELDS IN BRACES are filled by scripts/lpbf_k1.py from the study deck.
#
# UNITS: SI (m, s, K, W, J, Pa).

[Global]
  backend    = torch
  use_gpu    = true
  precision  = float64
  seed       = 0
  output_dir = ../../../../../../results/lpbf/in718/k1/free_surface_fit_h10/case3.1
[]

[Problem]
  type          = composed
  dimension     = 3
  finite_strain = false
[]

[Mesh]
  type      = box_mesh
  dim       = 3
  domain    = '0.0 0.0 0.0 700.0e-6 300.0e-6 4.0000e-04'
  divisions = '70 30 40'
[]

[Variables]
  [./temperature]
    family     = fem
    components = 1
    order      = 2
  []
  [./velocity]
    family     = fem
    components = 3
    order      = 2
  []
  [./pressure]
    family     = fem
    components = 1
    order      = 2
  []
  [./phi]
    family     = fem
    components = 1
    order      = 2
  []
[]

[Materials]
  [./in718]
    type     = phase_change_thermal
    solidus  = 1528.15            # 1255 C (hosaeus 2001 liquid)
    liquidus = 1610.15            # 1337 C (hosaeus 2001 liquid)
    # rho0 L = 8190 kg/m3 x 196.85 kJ/kg (agazhanov 2019 thermophysical, Table 1)
    latent_heat = 1.6122e9
    # rho0 c_p(T), rho0 = 8190 kg/m3; c_p: agazhanov Table 2 to 1400 K, hosaeus Table 2 at
    # the solidus (659) and in the liquid (775 J/kg/K)
    heat_capacity_table = '298.0 3.4808e6 400.0 3.6609e6 500.0 3.8329e6 600.0 4.0049e6 700.0 4.1769e6 800.0 4.3489e6 1100.0 5.2007e6 1200.0 5.2007e6 1300.0 5.2007e6 1400.0 5.1925e6 1528.15 5.3972e6 1610.15 6.3473e6'
    # agazhanov Table 2 (held at its last value up to the solidus)
    conductivity_solid_table = '298.0 9.94 400.0 11.59 500.0 13.24 600.0 14.91 700.0 16.61 800.0 18.34 1100.0 22.72 1200.0 23.61 1300.0 24.47 1400.0 25.32'
    # Wiedemann-Franz from the liquid resistivity of hosaeus Table 2 (derived)
    conductivity_liquid_table = '1610.15 26.800 1673.15 27.700 1773.15 29.100 1873.15 30.450 1973.15 31.800 2073.15 33.130'
    reference_temperature = 298.0
  []
[]

[Utilities]
  [./scan]
    kind         = scan_path
    power        = 325.0
    speed        = 0.9600
    radius       = 3.3500e-05        # 1/e^2 radius = D4sigma / 2
    track_length = 500.0e-6
    tracks       = 1
    center       = '350.0e-6 150.0e-6 350.0e-6'
  []
  [./state]
    kind        = process_state
    phase       = phi
    variable    = temperature
    material    = in718
    scan_path   = scan
    record_file = ../../../../../../results/lpbf/in718/k1/free_surface_fit_h10/case3.1/process_state.npz
  []
[]

[Kernels]
  [./storage]
    phase         = phi
    type          = enthalpy_time_derivative
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./conduction]
    phase         = phi
    type          = phase_change_conduction
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./laser]
    phase         = phi
    type              = beam_heat_source
    variable          = temperature
    scan_path         = scan
    absorptivity      = 0.65000
    penetration_depth = 4.50100e-05
  []
  [./surface]
    phase         = phi
    type                     = surface_heat_loss
    material      = in718          # makes the loss implicit at the nodes
    variable                 = temperature
    scan_path                = scan
    band_thickness           = 1.000e-05
    ambient_temperature      = 296.65
    convection_coefficient   = 10.0
    emissivity               = 0.4
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
    recondensation_fraction  = 0.18
  []
  [./carried]
    phase         = phi
    type      = flow_heat_advection
    variable  = temperature
    velocity  = velocity
    material  = in718
    upwind    = 1
    mesh_size = 1.000e-05
    reference_temperature = 1610.15    # enthalpy of the liquid at the liquidus
  []
  [./u_dot]
    type     = time_derivative
    variable = velocity
  []
  [./momentum]
    phase         = phi
    type                  = flow_momentum
    variable              = velocity
    pressure              = pressure
    temperature           = temperature
    material              = in718
    density               = 7578.0        # kg/m3, liquid
    viscosity             = 5.3e-3        # Pa s
    gravity               = '0.0 0.0 -9.81'
    expansion_coefficient = 5.0e-5        # 1/K, assumed
    reference_temperature = 1610.15
    drag_coefficient      = 1.0e8         # 1/s, assumed
    upwind                = 1
    mesh_size             = 1.000e-05
    gas_damping   = 1e+06
  []
  [./marangoni]
    phase         = phi
    type                     = thermocapillary_shear
    variable                 = velocity
    temperature              = temperature
    material                 = in718
    density                  = 7578.0
    surface_tension_gradient = -1.1000e-04
    band_thickness           = 1.000e-05
    scan_path                = scan
    recoil_coefficient       = 0.54
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
    surface_tension             = 1.8
    surface_tension_temperature = 1610.15
  []
  [./p_dot]
    type     = time_derivative
    variable = pressure
  []
  [./mass]
    phase         = phi
    type                 = flow_continuity
    variable             = pressure
    velocity             = velocity
    density              = 7578.0
    sound_speed          = 25
    pressure_diffusivity = 1.2500e-05
  []
  [./phi_dot]
    type     = time_derivative
    variable = phi
  []
  [./surface_motion]
    type            = phase_advection
    variable        = phi
    velocity        = velocity
    interface_width = 7.0000e-06        # eps = 0.7 h
    mobility        = 3
  []
[]

[ICs]
  [./plate]
    variable = temperature
    kind     = constant
    value    = 296.65
  []
  [./rest]
    variable = velocity
    kind     = constant
    value    = 0.0
  []
  [./p0]
    variable = pressure
    kind     = constant
    value    = 0.0
  []
  [./surface0]
    variable = phi
    kind     = tanh_interface
    axis     = 2
    position = 350.0e-6
    width    = 2.8000e-05        # 4 eps
  []
[]

[Executioner]
  type         = pf_fem_explicit
  dt           = 5.2869e-07            # 0.8 of h^2 / (6 (a + a_u U h / 2)), U the speed bound of the study deck
  n_steps      = 100000
  end_time     = 1.2000e-03
  energy_every = 0
  staged_variables = 'velocity pressure'
  staged_substeps  = 4
  snapshots_every  = 57
[]

[Output]
  formats         = 'json'
  save_checkpoint = false
[]
