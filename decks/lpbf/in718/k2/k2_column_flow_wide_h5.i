# GENERATED by scripts/lpbf_column_wide.py from k2_column_flow_h10.i: element size 5 um.
# Part V, case K2 WITH MELT-POOL FLOW in a WIDE block, for several GPUs.
#
# PROBLEM: the build column of k2_column_flow_h10.i (four powder layers of 40 um on 200 um
#   of plate, five tracks of 440 um per layer, 285 W, 960 mm/s, hatch 110 um, 90 degrees
#   between layers; temperature, velocity and pressure of the liquid, 30 grain fields) in
#   a block of 1.2 x 1.2 mm. In the 600 um block the pool with flow reached the walls
#   and the whole block became one pool (report section 6.11); here the scanned patch
#   keeps 380 um to every side. 4,000 plate grains (the grain size of the small block).
#
# DWELL: at least 1.0 ms between two tracks and 3.0 ms between two layers, and the scan
#   is HELD at the start of every track and of every layer until no element is liquid
#   (`hold_scan_until_solid` of the process state): a dwell is as long as the freezing
#   needs. (A single track with flow on the plate is solid 0.3 to 0.7 ms after the beam
#   has left; in a conduction check with a fixed 1 ms the third track of a layer still
#   started on liquid.) The next layer is spread when the layer dwell ENDS
#   (`recoat = dwell_end`), so the pool of a layer freezes under its own surface; only
#   then the block is set to the plate temperature (`layer_reset_temperature`, standing
#   for the tens of seconds of recoating). The history carries the accumulated hold
#   (`state.scan_delay`). After the run, `scripts/lpbf_column.py <this deck> dwell` lists
#   the liquid elements at the start of every track and layer: all must be 0.
#
# MESH AND MEMORY: 240 x 240 x 72 = 4,147,200 elements of 5 um. On the device
#   about 36 kB per element (measured: 4.70 GB for 129,600 elements, float64), so
#   140 GB in all: 70 GB per card on two cards, 47 on three, 35 on four.
#
# TIME: explicit steps of 0.125 us; 297,333 steps to 37.2 ms if no hold is
#   needed, more by the holds. The run ends when the path is over and all is solid
#   (`stop_when_solid`); `end_time` (57.2 ms) is an upper limit. Velocity and pressure
#   take four sub-steps per step (sound speed 25 m/s).
#
# SEVERAL GPUS (PINNACLE ADR 0057): name the cards at run time,
#     scripts/lpbf_column.py <this deck> run global.rank_devices="cuda:0 cuda:2 cuda:5"
#   The mesh is cut into one slab per card; the result does not depend on the cut.
#   `scripts/gpu_free.py <GB per card>` prints the cards with that much free memory.
#
# PARAMETERS: as k2_column_flow_h10.i (flow constants of the single-track study, grain
#   parameters of k2_column_h10.i); nothing is fitted here. The lengths tied to the
#   element follow it: band thicknesses and mesh_size 5 um, grain-boundary width
#   20 um, initial boundary width 10 um, seed radius 7.5 um.
#
# UNITS: SI (m, s, K, W, J, Pa).

[Global]
  backend    = torch
  use_gpu    = true
  precision  = float64
  seed       = 20261125
  output_dir = ../../../../results/lpbf/in718/k2/column_flow_wide_h5
[]

[Problem]
  type          = composed
  dimension     = 3
  finite_strain = false
[]

[Mesh]
  type      = box_mesh
  dim       = 3
  domain    = '0.0 0.0 0.0 1200.0e-6 1200.0e-6 360.0e-6'
  divisions = '240 240 72'
[]

[Variables]
  [./temperature]
    family     = fem
    components = 1
    order      = 2
  []
  [./eta]
    family     = fem
    components = 30
    order      = 2
  []
  [./velocity]
    family     = fem
    components = 3
    order      = 2
  []
  [./pressure]
    family     = fem
    components = 1
    order      = 2
  []
[]

[Materials]
  [./in718]
    type     = phase_change_thermal
    solidus  = 1528.15
    liquidus = 1610.15
    latent_heat = 1.6122e9
    heat_capacity_table = '298.0 3.4808e6 400.0 3.6609e6 500.0 3.8329e6 600.0 4.0049e6 700.0 4.1769e6 800.0 4.3489e6 1100.0 5.2007e6 1200.0 5.2007e6 1300.0 5.2007e6 1400.0 5.1925e6 1528.15 5.3972e6 1610.15 6.3473e6'
    conductivity_solid_table = '298.0 9.94 400.0 11.59 500.0 13.24 600.0 14.91 700.0 16.61 800.0 18.34 1100.0 22.72 1200.0 23.61 1300.0 24.47 1400.0 25.32'
    conductivity_liquid_table = '1610.15 26.80 1673.15 27.70 1773.15 29.10 1873.15 30.45 1973.15 31.80 2073.15 33.13'
    conductivity_powder = 0.3        # assumed: loose powder bed in argon
    reference_temperature = 298.0
  []
[]

[Utilities]
  [./scan]
    kind              = scan_path
    power             = 285.0
    speed             = 0.96
    radius            = 38.5e-6      # D4sigma 77 um / 2
    track_length      = 440.0e-6
    tracks            = 5
    hatch             = 110.0e-6
    layers            = 4
    layer_thickness   = 40.0e-6
    layer_rotation    = 90.0
    first_layer_angle = 90.0         # odd layers along Y, even layers along X
    serpentine        = true
    center            = '600.0e-6 600.0e-6 240.0e-6'
    initial_surface   = 200.0e-6     # top of the build plate
    track_dwell       = 1.0e-3       # a track is solid before the next starts
    layer_dwell       = 3.0e-3       # a layer is solid before the next is spread
    recoat            = dwell_end
  []
  [./state]
    kind                    = process_state
    variable                = temperature
    material                = in718
    scan_path               = scan
    substrate_top           = 200.0e-6
    layer_reset_temperature = 353.15
    record_file             = ../../../../results/lpbf/in718/k2/column_flow_wide_h5/process_state.npz
    series_file             = ../../../../results/lpbf/in718/k2/column_flow_wide_h5/temperature_series.npz
    state_series_file       = ../../../../results/lpbf/in718/k2/column_flow_wide_h5/consolidated_series.npz
    series_interval         = 2.0e-4
    hold_scan_until_solid   = true         # a track starts on solid material only
    stop_when_solid         = true         # end of the run: path over, all solid
  []
  [./nuclei]
    kind                = undercooling_nucleation
    variable            = eta
    temperature         = temperature
    material            = in718
    site_density        = 3.7e13     # assumed: one site per (30 um)^3
    mean_undercooling   = 5.0        # assumed
    undercooling_spread = 2.0        # assumed
    seed_radius         = 7.5000e-06
    clear_above         = 200.0e-6   # the initial grains fill the plate only
    process_state       = state      # a seed stays inside consolidated material
  []
[]

[Kernels]
  [./storage]
    type          = enthalpy_time_derivative
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./conduction]
    type          = phase_change_conduction
    variable      = temperature
    material      = in718
    process_state = state
  []
  [./laser]
    type              = beam_heat_source
    variable          = temperature
    scan_path         = scan
    absorptivity      = 0.7724       # K1 calibration (bare plate; kept for the powder layers)
    penetration_depth = 45.01e-6
  []
  [./surface]
    type                     = surface_heat_loss
    variable                 = temperature
    scan_path                = scan
    band_thickness           = 5.0000e-06
    ambient_temperature      = 353.15
    convection_coefficient   = 10.0
    emissivity               = 0.4
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
    recondensation_fraction  = 0.18
  []
  [./sides]
    type            = far_field_heat_loss
    variable        = temperature
    faces           = 'xmin xmax ymin ymax'
    band_thickness  = 5.0000e-06
    coefficient     = 2.0e4          # k / L with k = 20 W/(m K), L = 1 mm
    far_temperature = 353.15
  []
  [./carried]
    type          = flow_heat_advection
    variable      = temperature
    velocity      = velocity
    material      = in718
    upwind        = 1
    mesh_size     = 5.0000e-06
    reference_temperature = 1610.15
    process_state = state
  []
  [./u_dot]
    type     = time_derivative
    variable = velocity
  []
  [./momentum]
    type                  = flow_momentum
    variable              = velocity
    pressure              = pressure
    temperature           = temperature
    material              = in718
    density               = 7578.0        # kg/m3, liquid
    viscosity             = 5.3e-3        # Pa s
    gravity               = '0.0 0.0 -9.81'
    expansion_coefficient = 5.0e-5        # 1/K, assumed
    reference_temperature = 1610.15
    drag_coefficient      = 1.0e8         # 1/s, assumed
    upwind                = 1
    mesh_size             = 5.0000e-06
    process_state         = state
  []
  [./marangoni]
    type                     = thermocapillary_shear
    variable                 = velocity
    temperature              = temperature
    material                 = in718
    density                  = 7578.0
    surface_tension_gradient = -1.1e-4    # N/(m K), assumed
    band_thickness           = 5.0000e-06
    scan_path                = scan
    recoil_coefficient       = 0.54
    boiling_temperature      = 3186.0
    vaporization_latent_heat = 6.4e6
    molar_mass               = 0.0588
  []
  [./p_dot]
    type     = time_derivative
    variable = pressure
  []
  [./mass]
    type                 = flow_continuity
    variable             = pressure
    velocity             = velocity
    density              = 7578.0
    sound_speed          = 25
    pressure_diffusivity = 1.25e-5
    process_state        = state
  []
  [./eta_dot]
    type     = time_derivative
    variable = eta
  []
  [./grains]
    type                = thermal_grain_growth
    variable            = eta
    temperature         = temperature
    material            = in718
    boundary_energy     = 0.9
    boundary_width      = 2.0000e-05
    mobility_prefactor  = 0.111      # L at the liquidus, m3/(J s)
    activation_energy   = 1.5e6      # numerical: the front mobility is gone 100 K below the liquidus
    mobility_reference_temperature = 1610.15
    melting_rate        = 2.0e5
    solidification_rate = 1.0e5
    front_range         = 2.0
    selection_exponent  = 4.0
    orientation_seed    = 20261125
    process_state       = state      # grains grow into consolidated material only
  []
[]

[ICs]
  [./plate]
    variable = temperature
    kind     = constant
    value    = 353.15
  []
  [./grains0]
    variable       = eta
    kind           = polycrystal_coloring
    n_grains       = 4000
    n_order_params = 30
    int_width      = 1.0000e-05
    seed           = 7
  []
  [./rest]
    variable = velocity
    kind     = constant
    value    = 0.0
  []
  [./p0]
    variable = pressure
    kind     = constant
    value    = 0.0
  []
[]

[BCs]
  [./plate_bottom]
    variable   = temperature
    kind       = dirichlet
    node_set   = zmin
    components = [0]
    values     = [353.15]
  []
  [./rest_xmin]
    variable   = velocity
    kind       = dirichlet
    node_set   = xmin
    components = [0, 1, 2]
    values     = [0.0, 0.0, 0.0]
  []
  [./rest_xmax]
    variable   = velocity
    kind       = dirichlet
    node_set   = xmax
    components = [0, 1, 2]
    values     = [0.0, 0.0, 0.0]
  []
  [./rest_ymin]
    variable   = velocity
    kind       = dirichlet
    node_set   = ymin
    components = [0, 1, 2]
    values     = [0.0, 0.0, 0.0]
  []
  [./rest_ymax]
    variable   = velocity
    kind       = dirichlet
    node_set   = ymax
    components = [0, 1, 2]
    values     = [0.0, 0.0, 0.0]
  []
  [./rest_zmin]
    variable   = velocity
    kind       = dirichlet
    node_set   = zmin
    components = [0, 1, 2]
    values     = [0.0, 0.0, 0.0]
  []
[]

[Executioner]
  type            = pf_fem_explicit
  dt              = 1.250000e-07
  n_steps         = 1000000
  end_time        = 5.716667e-02     # upper limit; planned 37.2 ms plus the holds
  energy_every    = 0
  snapshots_every = 1600             # 200 us
  staged_variables = 'velocity pressure'
  staged_substeps  = 4
[]

[Output]
  formats         = 'json'
  save_checkpoint = false
[]
