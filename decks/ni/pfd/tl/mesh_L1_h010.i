# Mesh check of the restart (2026-11-15): L.1 on h010 (3,168 elements, 80 gage cells; l0 = 6 cells)
# with the h020 parameter set unchanged (CP set cal_center2, G_c 49.37, l0 0.6). Compared with the
# h020 calibration run (792 elements) on the curve, the failure strain and the fracture location.
[Specimen]
  out_dir = ../../../../results/ni_study/tl/pfd/mesh_L1_h010
  mesh             = ../../../../results/ni_study/mesh/h010/L.1/mesh.e
  orientations     = ../../../../data/extracted/ni_table1_orientations.csv
  group            = L
  thickness        = ../../../../data/extracted/ni_table2_thickness.csv
  specimen         = L.1
  gage_width       = 1.85
  length           = 25.4
  strain = 0.40
  t_end = 800          # gauge strain rate about 1e-3/s, as the CP calibration (600 s for 30 % bar strain)
  n_steps          = 400          # same 1e-3 grip strain per step
  snapshots_every  = 2
  backend          = torch
  use_gpu          = false
  threads = 8
  newton_tol       = 5.0e-2   # 2026-10-26: Newton floor of the implicit stress's FD tangent on multi-slip orientations (S01 1e-2 N); 5e-4 of the reaction; reactions unchanged at 5e-3 to 1e-7
  newton_rel_tol   = 1.0e-6
  max_cutbacks     = 10
  linear_method    = direct
  sparse_threshold = 500
  kinematics       = total_lagrangian
  state_update     = implicit
  state_iterations = 2
  C11     = 253000
  C12     = 152000
  C44     = 124000
  mu      = 26000
  gamma0  = 1.0e-5
  nexp    = 8.333333333333334
  tau_c0 = 0.26
  q_lat   = 1.4
  alpha0  = 0.4
  burgers = 2.5e-7
  rho0 = 2.0257e6
  k1 = 0.0243375
  y_c = 4.6689e-07
  predictor = linear
  memory_cap_gb    = 16
  Gc = 49.37       # the h020 calibration, unchanged
  l0               = 0.6
  zeta             = 1          # plastic-work driving force prefactor
  W_c = 0
  eta              = 0
  chi = 1
  damage_model     = at2
  stop_damage      = 0
  checkpoint_every = 8
[]
