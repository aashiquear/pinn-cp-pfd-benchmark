# Generated by scripts/polycrystal_plate.py from decks/polycrystal_plate/plate_n32_h40.i
# (stage 'deck'). Do not edit; edit the pipeline deck and regenerate.
# Pseudo-3D polycrystal plate, crystal plasticity only (no damage), on the
# geometry of the reference MOOSE deck moose/CPFE.i: 100 x 50 x 1 um, one
# HEX8 element through the thickness, pulled along +y from the top face.
#
# PLACEHOLDERS (@NAME@) are filled by scripts/polycrystal_plate.py from the
# pipeline deck; every value that reaches this file is recorded there.
#
# BOUNDARY CONDITIONS, as in the MOOSE deck: u_x = 0 on the left face (x = 0),
# u_y = 0 on the bottom face (y = 0), u_z = 0 on the back face (z = 0), and
# u_y prescribed on the top face (y = 50) by the ramp `pull`, which reaches
# 0.03 x 50 um at t_end. The right, front and the loaded faces are
# otherwise free, so the plate contracts laterally and through-thickness
# (generalized plane stress with one element through z).
#
# ORIENTATIONS. One Bunge triple per element, taken from the point file the
# pipeline writes after labelling the phase-field grain structure
# (`[OrientationField] source`, ADR 0026 in PINNACLE). The crystal block's
# own Euler angles are the per-QP field's fallback and are never used when
# the field covers the mesh.
#
# UNITS. micrometer, megapascal, second (the MOOSE deck's unit system).

[Global]
  backend    = numpy
  use_gpu    = false
  precision  = float64
  seed       = 0
  output_dir = /home/aashiquear/projects/pinn-cp-pfd-benchmark/results/polycrystal_plate/n32_h40/solver
[]

[Problem]
  type          = composed
  dimension     = 3
  finite_strain = true
[]

[Mesh]
  type      = box_mesh
  domain    = '0 0 0 100 50 1'
  divisions = '50 25 1'
[]

[Variables]
  [./u]
    family     = fem
    components = 3
  []
[]

[Functions]
  [./pull]
    # Top-face displacement: strain x height x t / t_end.
    kind       = parsed
    expression = 0.03*50.0*t/10
  []
[]

[Materials]
  [./cp]
    type                  = dislocation_density_cp
    C11                   = 108000
    C12                   = 61300
    C44                   = 28500
    mu                    = 25700
    gamma0                = 1e-05
    rate_exponent_n       = 8.33333333333
    tau_c0                = 0.112
    q_lat                 = 1.4
    alpha0                = 0.4
    burgers               = 0.000286
    rho0                  = 220
    k1                    = 0.3432
    annihilation_diameter = 0.00286
    [./crystal]
      structure    = fcc
      euler_angles = '0 0 0'
    []
  []
[]

[Kernels]
  [./sd_cp]
    type          = stress_divergence_cp
    variable      = u
    material      = cp
    dim           = 3
    finite_strain = true
    gnd           = false
  []
[]

[OrientationField]
  [./source]
    type          = point_file
    path          = orientations_points.csv
    interpolation = nearest
  []
[]

[BCs]
  [./x_left]
    variable   = u
    kind       = dirichlet
    node_set   = xmin
    components = [0]
    values     = [0.0]
  []
  [./y_bottom]
    variable   = u
    kind       = dirichlet
    node_set   = ymin
    components = [1]
    values     = [0.0]
  []
  [./z_back]
    variable   = u
    kind       = dirichlet
    node_set   = zmin
    components = [2]
    values     = [0.0]
  []
  [./y_pull_top]
    variable   = u
    kind       = dirichlet
    node_set   = ymax
    components = [1]
    values     = [1.0]
    function   = pull
  []
[]

[Executioner]
  type             = cp_quasi_static
  n_steps          = 40
  t_end            = 10
  newton_tol       = 1e-06
  max_iter         = 50
  max_cutbacks     = 10
  linear_method    = cg
  sparse_threshold = 0
[]

[Output]
  formats         = 'vtk csv json'
  save_checkpoint = false
  fields          = 'displacement stress strain equivalent_plastic_strain slip_activity mean_rho'
[]
