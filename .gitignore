# Scratch and build
__pycache__/
*.pyc
.venv/
scratch/
runs/
out/
.jf/

# Large or binary simulation artifacts stay out of git by default. The ones the
# report presents (field series behind its figures and animations, meshes,
# trained networks) are force-added by `scripts/ship_results.py
# decks/report/ship_results.i` and listed in results/SHIPPED.md (author's
# decision 2026-10-15).
*.e
*.exo
*.g
*.vtk
*.vtu
*.vtp
*.pvd
*.pkl
*.pt
*.h5
*.hdf5
*.tar.gz
*.zip
*.npy
# Field snapshots and solver dumps inside results
results/**/solver/fields*
# (results/cp_study/fields/ holds the field-series reruns; their vtk is ignored by *.vtk)
results/**/final_field.npz
# The reference MOOSE outputs stay on disk beside their decks, not in git
moose/*_out.e
