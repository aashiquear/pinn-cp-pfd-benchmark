# Scratch and build
__pycache__/
*.pyc
.venv/
scratch/
runs/
out/
.jf/

# Large or binary simulation artifacts never enter git. Shipped outputs are a
# later decision; until then every field file, mesh binary, checkpoint and
# archive bundle stays local.
*.e
*.exo
*.g
*.vtk
*.vtu
*.vtp
*.pvd
*.pkl
*.pt
*.h5
*.hdf5
*.tar.gz
*.zip
*.npy
# Field snapshots and solver dumps inside results
results/**/solver/fields*
# (results/cp_study/fields/ holds the field-series reruns; their vtk is ignored by *.vtk)
results/**/final_field.npz
# The reference MOOSE outputs stay on disk beside their decks, not in git
moose/*_out.e
